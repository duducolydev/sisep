# Modèle de configuration de production de SISEP.
#
# À copier en `.env` À LA RACINE DU DÉPÔT sur le serveur, puis à remplir.
# Ce fichier-ci est versionné et ne doit jamais contenir de vraie valeur ;
# le `.env` qui en dérive ne doit jamais être versionné ni partagé par
# messagerie.
#
#   cp .env.prod.example .env && chmod 600 .env

# --- Base de données -------------------------------------------------------
# Deux mots de passe distincts, longs et tirés au hasard. Pour en produire :
#   openssl rand -base64 24
MYSQL_DATABASE=sisep
MYSQL_USER=sisep
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Application -----------------------------------------------------------
# Clé de signature des cookies de session. La changer invalide toutes les
# sessions en cours, ce qui est sans gravité, mais ne doit pas être fait par
# inadvertance. Pour en produire :
#   openssl rand -hex 32
APP_SECRET=

APP_TIMEZONE=Africa/Dakar

# Port publié sur l'hôte. Le serveur héberge déjà d'autres services :
# vérifier qu'il est libre avec `sudo ss -ltnp | grep :8080`.
SISEP_PORT=8080

# Adresse à laquelle les utilisateurs atteignent SISEP. Elle est reprise
# telle quelle dans les liens des courriels : une valeur fausse donne des
# courriels avec des liens morts.
APP_URL_WEB=http://10.7.200.41:8080

# Origines autorisées en inter-origine. Front et API partageant l'hôte, il
# n'y en a aucune : laisser cette valeur, qui ne correspond à rien.
CORS_ALLOW_ORIGIN=^$

# --- Courriels -------------------------------------------------------------
# Transport SMTP. `null://null` désactive tout envoi sans faire échouer
# l'application : les relances et les notifications sont alors silencieuses.
# Pour Gmail ou Google Workspace, utiliser un mot de passe d'application et
# encoder l'arobase de l'identifiant en %40 :
#   MAILER_DSN=smtp://compte%40domaine.sn:motdepasseapplication@smtp.gmail.com:587
MAILER_DSN=null://null
MAILER_EXPEDITEUR_ADRESSE=no-reply@ansd.sn
MAILER_EXPEDITEUR_NOM="SISEP — PHASAOC"

# --- Compte d'administration ----------------------------------------------
# Adresse du premier compte administrateur, créé par la commande d'amorçage.
# Laisser vide n'en crée aucun — personne ne pourra alors se connecter.
ADMIN_EMAIL=
