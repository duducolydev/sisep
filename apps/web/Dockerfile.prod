# Image de production du front : construction puis service de fichiers
# statiques. Le serveur de développement de Vite n'a rien à faire ici — il
# recompile à la volée et n'est pas prévu pour être exposé.
#
# Le contexte de construction est la racine du dépôt (monorepo pnpm), pas
# apps/web : le verrou de dépendances et le paquet partagé vivent au-dessus.
FROM node:22-alpine AS build

RUN corepack enable && corepack prepare pnpm@10.30.3 --activate

WORKDIR /workspace

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/shared/package.json ./packages/shared/package.json

RUN pnpm install --frozen-lockfile

COPY apps/web ./apps/web
COPY packages/shared ./packages/shared

# VITE_API_URL n'est volontairement pas défini : le client retombe alors sur
# « /api/v1 », c'est-à-dire la même origine que la page. C'est ce qui permet
# à nginx de servir le front et l'API sous un seul hôte, et au cookie de
# session de rester first-party.
WORKDIR /workspace/apps/web
RUN pnpm build

FROM nginx:1.27-alpine AS runtime

COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
