# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# Port 3307 : le service "db" du docker-compose racine mappe MySQL sur ce
# port côté hôte pour ne pas entrer en conflit avec une instance locale sur
# 3306. Depuis le conteneur "api", DATABASE_URL est fourni par
# docker-compose.yml et pointe vers db:3306 (nom de service interne).
DATABASE_URL="mysql://sisep:!ChangeMe!@127.0.0.1:3307/sisep?serverVersion=8.0.37&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> app ###
# Fuseau d'affichage : Africa/Dakar (UTC+0, pas d'heure d'été — voir § 3.3 du brief)
APP_TIMEZONE=Africa/Dakar
###< app ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
###> symfony/mailer ###
# Transport SMTP. Valeur par défaut : aucun envoi réel (le message est
# simplement jeté), pour qu'un poste de développement fonctionne sans
# compte de messagerie. Les identifiants réels vont dans .env.local, jamais
# ici : ce fichier est versionné.
#   Gmail / Google Workspace, avec un mot de passe d'application :
#   MAILER_DSN=smtp://adresse%40domaine.sn:motdepasseapplication@smtp.gmail.com:587
MAILER_DSN=null://null
# Adresse et nom affichés comme expéditeur de tous les courriels sortants.
MAILER_EXPEDITEUR_ADRESSE=no-reply@sisep.local
MAILER_EXPEDITEUR_NOM="SISEP — PHASAOC"
###< symfony/mailer ###

###> application ###
# Base des liens insérés dans les courriels (fiche indicateur, connexion…).
APP_URL_WEB=http://localhost:5173
###< application ###

###> compte d'administration ###
# Adresse du compte administrateur de l'installation, recréé à chaque
# `app:db:seed --force`. Laissée vide ici : l'adresse réelle se déclare dans
# .env.local, qui n'est pas versionné.
ADMIN_EMAIL=
###< compte d'administration ###
